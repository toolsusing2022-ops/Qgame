; Engine configuration file.
; Godot 4.4.1-stable is the pinned engine for the MVP (gameplay spec GS-12.10).

config_version=5

[application]

config/name="Pixel Bead ASMR"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://game/assets/fonts/BeVietnamPro-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
